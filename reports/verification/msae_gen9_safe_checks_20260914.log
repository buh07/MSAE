    def _verify_historical_preflight_readonly() -> dict[str, Any]:
        raw = _regular_bytes(PREFLIGHT_FAILURE_PATH, mode=0o644)
        if base.sha_bytes(raw) != HISTORICAL_PREFLIGHT_SHA256:
            raise ValueError("historical preflight digest drift")
        value = base.strict_json_loads(raw.decode("utf-8"))
        if raw != base.canonical_bytes(value):
            raise ValueError("historical preflight canonical bytes drift")
        expected_top = {
            "schema_version", "protocol_id", "generation", "status",
            "reviewed_m2_completion_sha256", "config_entry", "commitment_entry",
            "public_key_entry", "private_key_lstat", "bound_runtime_sha256",
            "failure", "stage_a", "authorization_signature", "model_gpu_tmux",
            "successor_generation",
        }
        if (set(value) != expected_top
                or value.get("generation") != "post_m2_gen1_failed_preflight"
                or value.get("successor_generation") != "post_m2_gen2"
                or value.get("stage_a") != "not_run"
                or value.get("authorization_signature") != "not_created"
                or value.get("model_gpu_tmux") != "not_run"):
            raise ValueError("historical preflight semantics drift")
        for key, expected_path, expected_sha in (
            ("config_entry", V3_CONFIG / "protocol.json", FAILED_M3_CONFIG_SHA256),
            ("commitment_entry", V3_CONFIG / "authorization_commitment.json", FAILED_M3_COMMITMENT_SHA256),
            ("public_key_entry", V3_CONFIG / "ed25519_public.pem", FAILED_M3_PUBLIC_SHA256),
        ):
            entry = value[key]
            current = _regular_entry(expected_path)
            historical_projection = {key: current[key] for key in (
                "path", "type", "mode", "size", "sha256", "verification_action")}
            if (entry.get("path") != expected_path.relative_to(ROOT).as_posix()
                    or entry.get("sha256") != expected_sha
