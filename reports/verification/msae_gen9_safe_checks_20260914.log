    def _static_closure_analysis(*, root: Path = ROOT) -> dict[str, Any]:
        """Recursively resolve local imports and statically close dangerous surfaces."""
        queue = list(LOCAL_PYTHON_ENTRYPOINTS)
        parsed: dict[str, ast.Module] = {}
        import_edges: list[dict[str, str]] = []
        external_modules: set[str] = set()
        surfaces: list[dict[str, Any]] = []
        dynamic_imports: list[dict[str, Any]] = []
        process_calls = {"subprocess.run", "subprocess.check_output", "subprocess.check_call",
                         "subprocess.Popen", "os.execve", "os.execv", "os.execl", "os.system"}
        file_calls = {"open", "io.open", "os.open", "os.read", "os.write", "os.lseek",
                      "os.fstat", "os.fsync", "os.ftruncate", "os.fchmod", "os.close",
                      "os.mkdir", "os.rename", "os.replace", "os.unlink", "os.remove",
                      "os.stat", "os.lstat", "os.readlink", "os.chmod",
                      "os.scandir", "os.walk", "os.listdir", "shutil.rmtree",
                      "Path.open", "Path.read_bytes", "Path.read_text", "Path.write_bytes",
                      "Path.write_text", "Path.unlink", "Path.mkdir", "Path.rename",
                      "Path.replace", "Path.rmdir", "Path.exists", "Path.is_file",
                      "Path.is_dir", "Path.is_symlink", "Path.stat", "Path.lstat",
                      "Path.iterdir", "Path.rglob", "Path.glob", "Path.resolve"}
        library_calls = {"ctypes.CDLL", "ctypes.PyDLL", "ctypes.cdll.LoadLibrary"}
        network_calls = {"socket.socket", "socket.create_connection"}
        network_leaf_calls = {"connect", "bind", "listen", "accept", "sendall", "sendmsg",
                              "recv", "recvmsg", "getsockopt", "settimeout"}
        allowed_process_literals = {"/usr/bin/bash", "/usr/bin/git", "/usr/bin/ldd",
                                    "/usr/bin/nvidia-smi", "/usr/bin/strace", "/usr/bin/tmux",
                                    str(ROOT / ".venv-atlas/bin/python")}
        allowed_absolute_file_literals = {
                "/", "/proc", "/proc/net/unix", "/proc/self/fd", "/proc/self/maps",
                "/proc/self/mountinfo",
                "/dev/null", "/tmp", "/usr/${LIB}/",
            "/usr/lib/python3.12", "/usr/lib/x86_64-linux-gnu",
            "/usr/lib/x86_64-linux-gnu/libcuda.so.1",
            "/usr/lib/python3.12/site-packages", "/usr/local/lib/python3.12/dist-packages",
            "/usr/lib/python3/dist-packages", "/usr/bin/bash", "/usr/bin/git",
            "/usr/bin/ldd", "/usr/bin/nvidia-smi", "/usr/bin/strace", "/usr/bin/tmux",
                str(ROOT / ".venv-atlas/bin/python"), str(base.SNAPSHOT), str(ACTIVE_PRIVATE_KEY),
                str(PLAN_PATH), str(continuation.CONTROLLER_PATH), str(RUNTIME),
                str(RUNNER), str(LAUNCHER), str(TMUX_TEST_SUPERVISOR),
                str(RUNTIME_RFC), str(RUNTIME_TEST),
            str(base.PRIVATE_KEY), str(base.PRIMARY_BUILD_ROOT), str(base.REBUILD_BUILD_ROOT),
            str(base.STATE_ROOT), str(base.NONCE_DIR.parent), str(base.NONCE_DIR),
                str(base.GPU_LOCK_DIR), str(base.RUN_ROOT),
                    str(ACTIVE_CONFIG), str(ACTIVE_PROV), str(ACTIVE_M4_DATA),
                    str(ACTIVE_STATE), str(ACTIVE_NONCE_DIR),
                    str(ACTIVE_RUN_ROOT), str(SIGN_TRANSACTION),
                    str(M4_PRIMARY), str(M4_REBUILD), str(M4_TRANSACTION),
                    str(SETUP_JOURNAL), str(SETUP_MANIFEST),
                    str(SETUP_KEY_TRANSACTION),
                    str(SETUP_KEY_TRANSACTION / "private_key.payload"),
                    str(SETUP_KEY_TRANSACTION / "key_binding.json"),
                    str(CAPABILITY_ANALYSIS_ROOT), str(CAPABILITY_TRANSACTION),
                    str(CAPABILITY_REPORT), str(CAPABILITY_PROBE_ROOT),
                    str(CAPABILITY_PROBE_ROOT / "gen9_staging.json"),
                    str(CAPABILITY_PROBE_ROOT / "gen9_destination.json"),
                    str(NFS_PUBLISHER_TEST_ROOT), str(LOCAL_REJECTION_TEST_ROOT),
            str(predecessor_runtime.ACTIVE_PRIVATE_KEY),
            str(predecessor_runtime.ACTIVE_STATE), str(predecessor_runtime.ACTIVE_NONCE_DIR),
            str(predecessor_runtime.M4_PRIMARY), str(predecessor_runtime.M4_REBUILD),
            str(predecessor_runtime.ACTIVE_RUN_ROOT),
            "/tmp/msae_independent_measurement_v3_gen2_failure_reproduction",
            ("/tmp/msae_independent_measurement_v3_gen2_failure_reproduction/"
             ".venv-atlas/bin/python"),
            "/tmp/msae_surface_probe_check.json", "/tmp/msae_surface_probe_trace.log",
        }
        dynamic_process_mappings = {
            ("scripts/msae_independent_measurement_v3.py", "prescore_traced_check", "subprocess.run"):
                ["/usr/bin/strace"],
            ("scripts/msae_independent_measurement_v3.py", "broker", "os.execve"):
                [str(ROOT / ".venv-atlas/bin/python")],
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
             "_prescore_traced_check_impl", "subprocess.run"): ["/usr/bin/strace"],
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py", "broker", "os.execve"):
                [str(ROOT / ".venv-atlas/bin/python")],
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
             "_supervise_broker_process", "subprocess.Popen"):
                [str(ROOT / ".venv-atlas/bin/python")],
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_prescore_traced_check_impl", "subprocess.run"): ["/usr/bin/strace"],
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py", "broker", "os.execve"):
                [str(ROOT / ".venv-atlas/bin/python")],
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_supervise_broker_process", "subprocess.Popen"):
                [str(ROOT / ".venv-atlas/bin/python")],
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_run_tmux_client", "subprocess.Popen"):
                ["/usr/bin/tmux"],
        }
        dynamic_import_mappings = {
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
             "cpu_no_model_public_entry_trace", "runner_path"):
                ("scripts/run_msae_independent_calibration_v3.py",
                 "scripts/run_msae_independent_calibration_v3.py"),
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
             "_rooted_generic_build_stage_a", "dependency_path"):
                ("scripts/msae_measurement_v2.py", "msae_measurement_v2.py"),
            ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
             "_rooted_generic_build_stage_a", "builder_path"):
                ("scripts/msae_measurement_remediation_v1.py",
                 "msae_measurement_remediation_v1.py"),
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_rooted_generic_protocol_config", "builder_path"):
                ("scripts/msae_independent_measurement_v3.py",
                 "scripts/msae_independent_measurement_v3.py"),
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_rebuild_generic_config_at_synthetic_root", "builder_path"):
                ("scripts/msae_independent_measurement_v3.py",
                 "scripts/msae_independent_measurement_v3.py"),
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "cpu_no_model_public_entry_trace", "runner_path"):
                ("scripts/run_msae_independent_calibration_v3_gen9.py",
                 "scripts/run_msae_independent_calibration_v3_gen9.py"),
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_rooted_generic_build_stage_a", "dependency_path"):
                ("scripts/msae_measurement_v2.py", "msae_measurement_v2.py"),
            ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
             "_rooted_generic_build_stage_a", "builder_path"):
                ("scripts/msae_measurement_remediation_v1.py",
                 "msae_measurement_remediation_v1.py"),
        }
        # The exact canonical paths are enumerated separately in the closure's
        # typed finite-file registry.  Sites bind this registry identifier rather
        # than broad directory prefixes; the behavioral trace checks every observed
        # request against the registry entries.
        dynamic_file_mapping = ["typed_registry:msae_v3_finite_file_registry_v1"]
        path_taking_helpers = _path_taking_local_helpers(root=root)
        while queue:
            relative = queue.pop(0)
            if relative in parsed:
                continue
            path = root / relative
            tree = ast.parse(path.read_text(encoding="utf-8"), filename=relative)
            parsed[relative] = tree
            scopes = [(node.lineno, node.end_lineno or node.lineno, node.name)
                      for node in ast.walk(tree)
                      if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))]
            def enclosing(line: int) -> str:
                candidates = [(end - start, name) for start, end, name in scopes
                              if start <= line <= end]
                return min(candidates)[1] if candidates else "<module>"
            assignments_by_scope: dict[str, dict[str, list[ast.AST]]] = collections.defaultdict(
                lambda: collections.defaultdict(list))
            for assignment in ast.walk(tree):
                if isinstance(assignment, (ast.Assign, ast.AnnAssign)) and assignment.value is not None:
                    targets = assignment.targets if isinstance(assignment, ast.Assign) else [assignment.target]
                    for target in targets:
                        if isinstance(target, ast.Name):
                            assignments_by_scope[enclosing(assignment.lineno)][target.id].append(
                                assignment.value)
    
            def statically_assigned_literals(expression: ast.AST | None,
                                              scope: str,
                                              seen: frozenset[str] = frozenset()) -> set[str]:
                if expression is None:
                    return set()
                if isinstance(expression, ast.Constant) and isinstance(expression.value, str):
                    return {expression.value}
                if (isinstance(expression, ast.Call)
                        and _qualified_call_name(expression.func) in {"Path", "pathlib.Path"}
                        and expression.args):
                    return statically_assigned_literals(expression.args[0], scope, seen)
                if isinstance(expression, ast.Name) and expression.id not in seen:
                    values = (assignments_by_scope[scope].get(expression.id, [])
                              or assignments_by_scope["<module>"].get(expression.id, []))
                    return set().union(*(
                        statically_assigned_literals(value, scope, seen | {expression.id})
                        for value in values
                    )) if values else set()
                if isinstance(expression, ast.BinOp) and isinstance(expression.op, ast.Div):
                    left = statically_assigned_literals(expression.left, scope, seen)
                    right = statically_assigned_literals(expression.right, scope, seen)
                    return {str(Path(a) / b) for a in left for b in right}
                if isinstance(expression, ast.IfExp):
                    return (statically_assigned_literals(expression.body, scope, seen)
                            | statically_assigned_literals(expression.orelse, scope, seen))
                return set()
    
            def assignment_origin_expressions(expression: ast.AST | None, scope: str,
                                              seen: frozenset[str] = frozenset()) -> set[str]:
                if expression is None:
                    return set()
                result: set[str] = set()
                for name_node in (node for node in ast.walk(expression) if isinstance(node, ast.Name)):
                    if name_node.id in seen:
                        continue
                    values = (assignments_by_scope[scope].get(name_node.id, [])
                              or assignments_by_scope["<module>"].get(name_node.id, []))
                    for value in values:
                        result.add(f"{name_node.id}={ast.unparse(value)}")
                        result.update(assignment_origin_expressions(
                            value, scope, seen | {name_node.id}))
                return result
    
            def assignment_origin_string_literals(
                    expression: ast.AST | None, scope: str,
                    seen: frozenset[str] = frozenset()) -> set[str]:
                if expression is None:
                    return set()
                result = {node.value for node in ast.walk(expression)
                          if isinstance(node, ast.Constant) and isinstance(node.value, str)}
                for name_node in (node for node in ast.walk(expression)
                                  if isinstance(node, ast.Name)):
                    if name_node.id in seen:
                        continue
                    values = (assignments_by_scope[scope].get(name_node.id, [])
                              or assignments_by_scope["<module>"].get(name_node.id, []))
                    for value in values:
                        result.update(assignment_origin_string_literals(
                            value, scope, seen | {name_node.id}))
                return result
            dangerous_attributes = (process_calls | file_calls | library_calls | network_calls
                                    | network_leaf_calls)
            dangerous_leaf_names = {value.rsplit(".", 1)[-1] for value in dangerous_attributes}
            call_aliases: dict[str, str] = {}
            module_aliases: dict[str, str] = {}
            for candidate in ast.walk(tree):
                if isinstance(candidate, ast.Import):
                    for alias in candidate.names:
                        head = alias.name.split(".", 1)[0]
                        if head in {"subprocess", "os", "socket", "ctypes", "io", "pathlib", "importlib"}:
                            module_aliases[alias.asname or head] = head
                elif isinstance(candidate, ast.ImportFrom) and candidate.module == "pathlib":
                    for alias in candidate.names:
                        if alias.name == "Path":
                            module_aliases[alias.asname or alias.name] = "Path"
            def normalize_call(value: str | None) -> str | None:
                if value is None:
                    return None
                head, separator, tail = value.partition(".")
                replacement = module_aliases.get(head)
                return f"{replacement}{separator}{tail}" if replacement is not None else value
            for candidate in ast.walk(tree):
                if isinstance(candidate, (ast.Assign, ast.AnnAssign)):
                    value = candidate.value
                    qualified = normalize_call(_qualified_call_name(value)) if value is not None else None
                    if qualified in dangerous_attributes:
                        targets = (candidate.targets if isinstance(candidate, ast.Assign)
                                   else [candidate.target])
                        if len(targets) != 1 or not isinstance(targets[0], ast.Name):
                            raise ValueError(f"indirect dangerous-call alias is forbidden: "
                                             f"{relative}:{candidate.lineno}")
                        call_aliases[targets[0].id] = qualified
                elif isinstance(candidate, ast.ImportFrom) and candidate.module in {
                        "subprocess", "ctypes", "socket", "pathlib", "os", "io"}:
                    for alias in candidate.names:
                        qualified = f"{candidate.module}.{alias.name}"
                        if qualified in dangerous_attributes:
                            call_aliases[alias.asname or alias.name] = qualified
            imports: list[tuple[str, int]] = []
            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    imports.extend((alias.name, node.lineno) for alias in node.names)
                elif isinstance(node, ast.ImportFrom):
                    if node.level:
                        raise ValueError(f"relative local import is not supported by frozen resolver: {relative}:{node.lineno}")
                    if node.module:
                        imports.append((node.module, node.lineno))
                elif isinstance(node, ast.Call):
                    name = normalize_call(_qualified_call_name(node.func))
                    planted_probe_scope = (relative in {
                        "scripts/msae_independent_measurement_v3_post_m1_runtime.py",
                        "scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py"} and
                        enclosing(node.lineno) == "cpu_no_model_public_entry_trace")
                    if isinstance(node.func, (ast.Call, ast.Subscript, ast.Lambda)) and not planted_probe_scope:
                        raise ValueError(f"unresolved dynamic callable is forbidden: {relative}:{node.lineno}")
                    if name in {"eval", "exec", "compile"}:
                        raise ValueError(f"runtime code evaluation is forbidden: {relative}:{node.lineno}:{name}")
                    if name == "getattr":
                        if len(node.args) < 2 or not isinstance(node.args[1], ast.Constant) or \
                                not isinstance(node.args[1].value, str):
                            allowed_dynamic_getattr = {
                                ("scripts/msae_independent_measurement_v3_post_m1.py", "__getattr__"),
                                ("scripts/msae_independent_measurement_v3_post_m1_runtime.py",
                                 "verify_authorization"),
                                ("scripts/msae_independent_measurement_v3_post_m2_gen9_runtime.py",
                                 "verify_authorization"),
                            }
                            if (relative, enclosing(node.lineno)) not in allowed_dynamic_getattr:
                                raise ValueError(f"dynamic getattr dispatch is forbidden: {relative}:{node.lineno}")
                        elif node.args[1].value in dangerous_leaf_names and not planted_probe_scope:
                            raise ValueError(f"indirect dangerous getattr is forbidden: "
                                             f"{relative}:{node.lineno}:{node.args[1].value}")
                    if name in call_aliases:
                        name = call_aliases[name]
                    if name in {"__import__", "importlib.import_module"}:
                        raise ValueError(f"dynamic import is forbidden: {relative}:{node.lineno}:{name}")
                    if name in {"importlib.util.spec_from_file_location",
                                "continuation.source_only_module_spec"}:
                        scope = enclosing(node.lineno)
                        if len(node.args) < 2:
                            raise ValueError(
                                f"dynamic import lacks an exact path argument: {relative}:{node.lineno}")
                        argument_expression = ast.unparse(node.args[1])
                        mapping = dynamic_import_mappings.get(
                            (relative, scope, argument_expression))
                        if mapping is None:
                            raise ValueError(
                                f"dynamic import site lacks an exact mapping: "
                                f"{relative}:{scope}:{argument_expression}")
                        target, required_origin_literal = mapping
                        origin_literals = assignment_origin_string_literals(
                            node.args[1], scope)
                        if required_origin_literal not in origin_literals:
                            raise ValueError(
                                f"dynamic import target origin drift: {relative}:{scope}:"
                                f"{argument_expression}:{sorted(origin_literals)}")
                        dynamic_imports.append({"path": relative, "line": node.lineno,
                                                "operation": name,
                                                "argument_expression": argument_expression,
                                                "assignment_origin_literals": sorted(origin_literals),
                                                "finite_mapping": [target]})
                    leaf = node.func.attr if isinstance(node.func, ast.Attribute) else None
                    helper_leaf = (node.func.attr if isinstance(node.func, ast.Attribute)
                                   else node.func.id if isinstance(node.func, ast.Name) else None)
                    helper_path_bindings = path_taking_helpers.get(str(helper_leaf), ())
                    helper_path_indices = tuple(index for index, _ in helper_path_bindings)
                    category = ("process" if name in process_calls else
                                "file" if name in file_calls or
                                helper_path_indices or
                                (leaf in
                                 {"open", "read_bytes", "read_text", "write_bytes", "write_text",
                                  "unlink", "mkdir", "rename", "replace", "rmdir", "exists",
                                  "is_file", "is_dir", "is_symlink", "stat", "lstat", "iterdir",
                                  "rglob", "glob", "resolve", "ftruncate", "fchmod", "close",
                                  "remove", "chmod", "readlink", "rmtree"}) else
                                "library" if name in library_calls else
                                "network" if name in network_calls or leaf in network_leaf_calls else None)
                    if category is not None:
                        # This one function contains deliberately forbidden calls
                        # executed only after all real surfaces are monkeypatched;
                        # they are behavioral negative fixtures, never allowlist
                        # entries.
                        if planted_probe_scope:
                            continue
                        if name == "os.system" or any(keyword.arg == "shell" and
                                                       isinstance(keyword.value, ast.Constant) and
                                                       keyword.value.value is True
                                                       for keyword in node.keywords):
                            raise ValueError(f"shell expansion is forbidden: {relative}:{node.lineno}")
                        if category == "network" and name == "socket.socket":
                            explicit_unix = (bool(node.args)
                                and isinstance(node.args[0], ast.Attribute)
                                and _qualified_call_name(node.args[0]) == "socket.AF_UNIX")
                            typed_inherited_fd = (not node.args
                                and len(node.keywords) == 1
                                and node.keywords[0].arg == "fileno")
                            if not (explicit_unix or typed_inherited_fd):
                                raise ValueError(
                                    f"non-UNIX network surface is forbidden: {relative}:{node.lineno}")
                        literal = None
                        file_literal = None
                        scope = enclosing(node.lineno)
                        path_argument_index = helper_path_indices[0] if helper_path_indices else 0
                        path_argument: ast.AST | None = (
                            node.args[path_argument_index]
                            if len(node.args) > path_argument_index else None)
                        if path_argument is None and helper_path_bindings:
                            keyword_names = {name for index, name in helper_path_bindings
                                             if index == path_argument_index}
                            matches = [keyword.value for keyword in node.keywords
                                       if keyword.arg in keyword_names]
                            if len(matches) == 1:
                                path_argument = matches[0]
                        if (path_argument is None and category == "file"
                                and isinstance(node.func, ast.Attribute)
                                and not (name or "").startswith(("os.", "io."))):
                            path_argument = node.func.value
                        if path_argument is not None:
                            first = path_argument
                            if isinstance(first, ast.Constant) and isinstance(first.value, (str, type(None))):
                                literal = first.value
                            elif (isinstance(first, (ast.List, ast.Tuple)) and first.elts
                                  and isinstance(first.elts[0], ast.Constant)
                                  and isinstance(first.elts[0].value, (str, type(None)))):
                                literal = first.elts[0].value
                            elif (isinstance(first, ast.Call)
                                  and _qualified_call_name(first.func) in {"Path", "pathlib.Path"}
                                  and first.args and isinstance(first.args[0], ast.Constant)
                                  and isinstance(first.args[0].value, str)):
                                literal = first.args[0].value
                        receiver_literal = None
                        if (category == "file" and isinstance(node.func, ast.Attribute)
                                and isinstance(node.func.value, ast.Call)
                                and _qualified_call_name(node.func.value.func) == "Path"
                                and node.func.value.args
                                and isinstance(node.func.value.args[0], ast.Constant)
                                and isinstance(node.func.value.args[0].value, str)):
                            receiver_literal = node.func.value.args[0].value
                        file_literal = receiver_literal if receiver_literal is not None else literal
                        if (category == "file" and isinstance(file_literal, str)
                                and os.path.isabs(file_literal)
                                and file_literal not in allowed_absolute_file_literals):
                            raise ValueError(f"absolute file literal is outside the typed finite registry: "
                                             f"{relative}:{node.lineno}:{file_literal}")
                        assigned_literals = statically_assigned_literals(path_argument, scope)
                        forbidden_assigned = sorted(
                            value for value in assigned_literals
                            if os.path.isabs(value) and value not in allowed_absolute_file_literals
                        )
                        if forbidden_assigned and not planted_probe_scope:
                            raise ValueError(
                                "dynamic file value has an assigned literal outside the finite registry: "
                                f"{relative}:{scope}:{node.lineno}:{forbidden_assigned}")
                        if category == "process" and literal is not None:
                            if not isinstance(literal, str) or literal not in allowed_process_literals:
                                raise ValueError(
                                    f"process target is outside the static allowlist: "
                                    f"{relative}:{node.lineno}:{literal!r}")
                        if category == "library" and literal is not None:
                            raise ValueError(
                                f"literal dlopen target is outside the distribution/ELF closure: "
                                f"{relative}:{node.lineno}:{literal!r}")
                        finite_mapping: list[Any]
                        if category == "file":
                            finite_mapping = dynamic_file_mapping
                        elif category == "process":
                            finite_mapping = ["typed_registry:msae_v3_finite_process_registry_v1"]
                        elif category == "network":
                            finite_mapping = (["AF_UNIX"] if name == "socket.socket" else
                                              ["typed_registry:unix_socket_path_or_bound_socket"])
                        elif category == "library":
                            if not node.args or not isinstance(node.args[0], ast.Constant) or node.args[0].value is not None:
                                raise ValueError(
                                    f"dynamic dlopen site lacks a finite mapping: {relative}:{node.lineno}")
                            finite_mapping = ["process_global_libc"]
                        else:
                            finite_mapping = dynamic_file_mapping
                        site_payload = {"path": relative, "function": scope,
                                        "category": category,
                                        "operation": name if name is not None else f"<dynamic>.{leaf}",
                                        "receiver_expression": (ast.unparse(node.func.value)
                                                                if isinstance(node.func, ast.Attribute)
                                                                else None),
                                        "argument_expression": (
                                            ast.unparse(path_argument)
                                            if path_argument is not None else None),
                                        "assignment_origin_expressions": sorted(
